# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
build/
*.ipa
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
android/keystore.properties

# Firebase / emulator. android/app/google-services.json is deliberately NOT
# ignored: its values are public-by-design for a mobile client, and the API key
# inside is restricted in the Google Cloud console instead (see spec §18).
functions/.env
functions/.env.*
.firebase/
*-debug.log
*-error.log

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
# /ios
# /android

# party companion Vite output
party-server/public/
streamflix-main/*

flixquest-scraper-main/*
flixquest-main/*
# JVM crash dumps from local gradle builds
hs_err_pid*.log
replay_pid*.log
