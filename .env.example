# TMDB API — https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
EXPO_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Wyzie subtitles — https://store.wyzie.io/redeem
EXPO_PUBLIC_WYZIE_BASE_URL=https://sub.wyzie.io
EXPO_PUBLIC_WYZIE_API_KEY=your_wyzie_api_key

# Sample playback source used by the video player
EXPO_PUBLIC_SAMPLE_VIDEO_URL=https://media.w3.org/2010/05/sintel/trailer.mp4

# Watch party room server (WebSocket). Leave empty to hide the feature.
EXPO_PUBLIC_WATCH_PARTY_URL=

# FlixQuest scraper API (VOD providers + Live TV). Leave empty to hide VOD
# FlixQuest servers; Live TV still shows the default PH M3U playlist.
# No trailing /api/v2 — the client appends it. Example: https://flixquest-scraper.vercel.app
EXPO_PUBLIC_FLIXQUEST_API_URL=

# Optional Live TV M3U playlist. Unset uses the default PH IPTV list.
# EXPO_PUBLIC_LIVE_TV_M3U_URL=https://raw.githubusercontent.com/Harleythetech/IPHTV/main/ph.m3u

# Party-server web catalog. Same TMDB key as EXPO_PUBLIC_TMDB_API_KEY.
# party-server also falls back to EXPO_PUBLIC_TMDB_API_KEY if this is unset.
TMDB_API_KEY=

# App versioning — used by app.config.js, android/app/build.gradle, and the
# party-server web UI (GET /health). Bump both for each release APK;
# ANDROID_VERSION_CODE must always increase.
APP_VERSION=2.1.5
ANDROID_VERSION_CODE=20105

# Optional Mac Catalyst signing identity (codesign -s). Unset = auto-detect
# Developer ID Application, then Apple Development, then ad-hoc (-).
# A real identity is required for Camera / Microphone TCC prompts.
# Quote the value — team IDs in parentheses break `source .env` otherwise.
# MACOS_CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# MACOS_CODESIGN_IDENTITY="Apple Development: you@email.com (TEAMID)"
# Firebase / Google Sign-In (project streamz-c98b9)
# Optional. src/config/env.ts already defaults to the project's OAuth *web*
# client id (the client_type 3 entry in android/app/google-services.json), so
# sign-in works without this. Set it only when pointing at another project.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=283831382421-xxxx.apps.googleusercontent.com

# In-app updates (P20). These are public identifiers, not secrets — a GitHub
# owner/name is readable by anyone, and the APK it points at is only accepted
# after its SHA-256, package name and signing certificate are verified on the
# device. Nothing is baked into the app: unset means no update source at all,
# so a build can never silently offer another project's releases.
# The production release workflow and this example point at this repository;
# FEATURES.updateChecker is true. The updater remains fail-closed until a
# release policy is published and the native integrity check passes on-device.
EXPO_PUBLIC_UPDATE_REPO_OWNER=mir-majid01
EXPO_PUBLIC_UPDATE_REPO_NAME=StreamZ

# Hours a cached mandatory-update policy may still gate the app when Firestore
# is unreachable (default 72, capped at 168). Only a network failure may use
# the cache; a refused, missing, or malformed policy never does.
# EXPO_PUBLIC_UPDATE_OFFLINE_GRACE_HOURS=72
