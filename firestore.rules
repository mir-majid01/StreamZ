rules_version = '2';

// StreamZ — the single security authority for BOTH clients on project streamz-c98b9.
//
// There is no Cloud Functions tier (Spark plan), so nothing runs on a server between the
// subscriber and the database. Everything the old `activateKey` / `validateAccess`
// callables decided in code is decided here instead, which makes this file the product's
// actual backend. It is deployed from the StreamZ repository; StreamZ Admin keeps no rules
// of its own — its writes have to satisfy these conditions or they are refused.
//
// Two audiences, one database:
//   subscriber  — signed in with no `role` claim. Sees only its own documents, plus the
//                 one key document it can address by hash.
//   staff       — signed in carrying a `role` custom claim (admin | manager | support) set
//                 by hand in the Firebase console. Custom claims are not writable from any
//                 client, which is the only reason a phone can be trusted to mint keys.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ vocabulary

    function signedIn() {
      return request.auth != null;
    }

    function tokenRole() {
      return signedIn() && 'role' in request.auth.token ? request.auth.token.role : '';
    }

    function isAdmin() {
      return tokenRole() == 'admin';
    }

    // admin and manager may mutate entitlements; support may only read and reset bindings.
    function isKeyStaff() {
      return tokenRole() in ['admin', 'manager'];
    }

    function isStaff() {
      return tokenRole() in ['admin', 'manager', 'support'];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function config() {
      return get(/databases/$(database)/documents/config/app).data;
    }

    // Absent config means the owner has not run setup, which is a refusal rather than an
    // open ceiling.
    function rotationCeiling() {
      return exists(/databases/$(database)/documents/config/app)
        ? config().maxInstallationRotations
        : 0;
    }

    function isHash(id) {
      return id.matches('^[0-9a-f]{64}$');
    }

    // Keys minted before sub-day durations existed carry only durationDays. Reading the
    // length through this instead of `data.durationMs` keeps them activatable after the
    // change instead of erroring the rule open on a missing field.
    function keyDurationMs(data) {
      return 'durationMs' in data ? data.durationMs : data.durationDays * 86400000;
    }

    // Documents minted before the rotation counter existed read as zero rather than
    // erroring out, which would silently freeze every activation on legacy accounts.
    function rotationsOf(data) {
      return 'installationRotations' in data ? data.installationRotations : 0;
    }

    // The document id of a key IS the SHA-256 of its plaintext. Addressing by id is what
    // lets a subscriber reach exactly one key without being able to list the collection:
    // rules cannot see a query's filters, so `list` on subscriptionKeys would hand every
    // signed-in device the entire keyspace.
    function keyDocAfter(id) {
      return getAfter(/databases/$(database)/documents/subscriptionKeys/$(id)).data;
    }

    function keyExists(id) {
      return existsAfter(/databases/$(database)/documents/subscriptionKeys/$(id));
    }

    // A subscription is only real if the key it points at is ACTIVE and bound to this uid.
    // Checked against getAfter so an activation transaction, which writes both documents,
    // can be validated as a unit.
    function boundToMe(id) {
      return keyExists(id)
        && keyDocAfter(id).uid == request.auth.uid
        && keyDocAfter(id).status == 'ACTIVE';
    }

    // ------------------------------------------------------------------ users/{uid}

    match /users/{uid} {
      allow get: if isOwner(uid) || isStaff();
      // Subscribers never list this collection; staff page through it in the admin app.
      allow list: if isStaff();

      // First activation creates the document. Identity fields come from the token so a
      // device cannot mint an account under somebody else's address.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == (signedIn() && 'email' in request.auth.token
              ? request.auth.token.email
              : '')
        && request.resource.data.status == 'active'
        && request.resource.data.installationRotations == 0
        && request.resource.data.createdAt == request.resource.data.lastLoginAt
        && request.resource.data.createdAt == request.resource.data.lastActiveAt
        && request.resource.data.expiresAt > request.resource.data.activatedAt
        && request.resource.data.activatedAt >= request.resource.data.createdAt - 300000
        && boundToMe(request.resource.data.subscriptionId)
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'status', 'subscriptionId', 'installationId', 'activatedAt',
          'expiresAt', 'lastLoginAt', 'lastActiveAt', 'appVersion', 'installationRotations',
          'createdAt'
        ]);

      allow update: if (
        // Presence heartbeat — the one write that needs no entitlement behind it.
        isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
      ) || (
        // An activation. `role` is absent from the list on purpose: a client that could
        // write it could promote itself, and these rules are the only thing standing
        // between a phone and the admin console.
        isOwner(uid)
        // Staff accounts are seeded by hand with only createdAt/status/role/email, so the
        // identity fields this branch reasons about can be absent. Reading an absent
        // property is an evaluation error, which denies the activation outright — and
        // isOwner plus the uid equality below pin the value this write may carry.
        && (!('uid' in resource.data) || resource.data.uid == uid)
        && request.resource.data.uid == uid
        // `uid` is listed because a hand-made document gains it on first activation; a
        // document that already has it leaves it untouched and out of the diff.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'status', 'subscriptionId', 'installationId', 'activatedAt', 'expiresAt',
          'lastLoginAt', 'lastActiveAt', 'appVersion', 'installationRotations'
        ])
        // The counter only ever steps by one, and only when the installation changed, so a
        // device cannot quietly reset its way back to a fresh rotation budget.
        && rotationsOf(request.resource.data) >= rotationsOf(resource.data)
        && rotationsOf(request.resource.data) <= rotationCeiling()
        && (
          !('installationId' in resource.data)
          || request.resource.data.installationId == resource.data.installationId
          || rotationsOf(request.resource.data) == rotationsOf(resource.data) + 1
        )
        // The subscription a device claims must exist, be ACTIVE, and be bound to it.
        && boundToMe(request.resource.data.subscriptionId)
        // Never more time than the key itself grants, so a stale user document cannot
        // outlive a key the admin has shortened.
        && request.resource.data.expiresAt <= keyDocAfter(request.resource.data.subscriptionId).expiresAt
      ) || (
        isKeyStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'expiresAt', 'installationId', 'lastActiveAt', 'appVersion'])
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------------ subscriptionKeys

    match /subscriptionKeys/{keyId} {
      // Staff read the ledger. A subscriber may read a key only when it is still unbound
      // (so it can be activated) or already theirs — and only by knowing the plaintext.
      allow get: if isStaff()
        || (signedIn() && (resource.data.status == 'UNUSED' || resource.data.uid == request.auth.uid));
      allow list: if isStaff();

      // Minting is staff-only, hashes-only, and always starts UNUSED.
      //
      // createdAt is the client's clock and request.time is the server's, so the two are
      // only ever approximately ordered: a warm write stream can commit a mutation before
      // the server clock reaches the instant the device stamped it. A strict comparison
      // therefore refuses honest mints at random, so a bounded skew window is allowed.
      // Five minutes matches the window the activation branch already grants.
      //
      // durationMs is the authoritative term and durationDays its whole-day ceiling. Keeping
      // durationDays bounded and mutually consistent with durationMs means the legacy readers
      // that only understand days still see a true upper bound, and a mint cannot claim a
      // 30-day label around a 5-minute term.
      //
      // The one-minute floor is the same constant the generator enforces
      // (admin-z-app SubscriptionKey.MIN_DURATION_MS), so a duration the admin UI accepts is
      // always a duration the database will store. It is one minute rather than five because
      // a short term is how a key gets tested, and a floor above the smallest unit the UI
      // enters only produces a write that the rules then refuse.
      allow create: if isKeyStaff()
        && isHash(keyId)
        && request.resource.data.keyHash == keyId
        && request.resource.data.status == 'UNUSED'
        && request.resource.data.durationDays >= 1
        && request.resource.data.durationDays <= 3650
        && request.resource.data.durationMs >= 60000
        && request.resource.data.durationMs <= request.resource.data.durationDays * 86400000
        && request.resource.data.durationMs > (request.resource.data.durationDays - 1) * 86400000
        && request.resource.data.createdAt <= request.time.toMillis() + 300000
        && !('uid' in request.resource.data)
        && !('activatedAt' in request.resource.data)
        && request.resource.data.keys().hasAll([
          'keyHash', 'status', 'durationDays', 'durationMs', 'createdAt', 'createdBy'
        ]);

      // Two very different writes share this path and must not be confused:
      allow update: if (
        // ... a staff correction: revoke, expire, extend, rebind.
        isKeyStaff()
        && request.resource.data.keyHash == resource.data.keyHash
        && request.resource.data.durationDays == resource.data.durationDays
        && keyDurationMs(request.resource.data) == keyDurationMs(resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['UNUSED', 'ACTIVE', 'EXPIRED', 'REVOKED']
      ) || (
        // ... or the subscriber's activation, and the ONLY transition it may make.
        signedIn()
        && resource.data.status == 'UNUSED'
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.uid == request.auth.uid
        // Admin-owned fields are immutable under a subscriber write.
        && request.resource.data.keyHash == resource.data.keyHash
        && request.resource.data.durationDays == resource.data.durationDays
        && keyDurationMs(request.resource.data) == keyDurationMs(resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        // Duration arithmetic is checked in the database's own units. activatedAt comes
        // from the phone, so it is pinned to a five-minute window around this write's
        // server timestamp rather than to the timestamp itself — a strict upper bound
        // would refuse an activation the moment the device clock ran ahead.
        && request.resource.data.activatedAt <= request.time.toMillis() + 300000
        && request.resource.data.activatedAt >= request.time.toMillis() - 300000
        && request.resource.data.expiresAt
             == request.resource.data.activatedAt + keyDurationMs(resource.data)
        && request.resource.data.installationId.size() >= 8
        // Everything else the minting side wrote has to survive the merge.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'uid', 'installationId', 'activatedAt', 'expiresAt', 'lastValidatedAt'
        ])
      );

      allow delete: if false;

      // Per-key lifecycle trail, written by staff only.
      match /lifecycle/{eventId} {
        allow read: if isStaff();
        allow create: if isKeyStaff();
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ devices

    match /devices/{deviceId} {
      // id is always `${uid}__${installationId}`, so ownership is derivable from the id.
      function deviceOwner() {
        return deviceId.split('__')[0];
      }

      allow get: if isOwner(deviceOwner()) || isStaff();
      allow list: if isStaff()
        || (signedIn() && request.query.limit <= 20 && deviceOwner() == request.auth.uid);

      // The activation transaction creates the record for the installation it just bound
      // and stamps rotatedAt on the one it replaced.
      allow create: if isOwner(deviceOwner())
        && request.resource.data.uid == deviceOwner()
        && request.resource.data.rotatedAt == null
        && request.resource.data.keys().hasAll([
          'uid', 'installationId', 'deviceModel', 'appVersion', 'activatedAt', 'rotatedAt'
        ]);

      allow update: if (
        isOwner(deviceOwner())
        && resource.data.uid == deviceOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.installationId == resource.data.installationId
        // Closing out an old installation is the only edit a device may make to history.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rotatedAt'])
      ) || (
        isKeyStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rotatedAt'])
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------------ watch sessions

    // Append-and-finalize. A document becomes immutable the moment it is finalized,
    // because updates are only permitted while the stored state is 'open'.
    match /watchSessions/{sessionId} {
      allow get: if isOwner(sessionId.split('__')[0]) || isStaff();
      allow list: if isStaff()
        || (signedIn() && request.query.limit <= 50 && sessionId.split('__')[0] == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.state == 'open'
        && request.resource.data.sessionId == sessionId
        && sessionId.split('__')[0] == request.auth.uid
        && request.resource.data.watchDurationMs >= 0
        && request.resource.data.watchDurationMs <= request.resource.data.durationMs
        && request.resource.data.keys().hasAll([
          'sessionId', 'uid', 'state', 'startedAt', 'contentId', 'durationMs',
          'watchDurationMs'
        ]);

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.state == 'open'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.state in ['open', 'finalized']
        && request.resource.data.watchDurationMs >= resource.data.watchDurationMs
        && request.resource.data.watchDurationMs <= request.resource.data.durationMs;

      allow delete: if false;
    }

    // ------------------------------------------------------------------ rollups

    // Per-subscriber daily totals. With no scheduled function, the device that earns the
    // watch time also writes the total — bounded so one client cannot invent a day of
    // infinite viewing, and limited to its own uid by the id.
    match /userDailyStats/{statId} {
      function statOwner() {
        return statId.split('__')[0];
      }

      allow get: if isOwner(statOwner()) || isStaff();
      allow list: if isStaff()
        || (signedIn() && request.query.limit <= 31 && statOwner() == request.auth.uid);

      allow create: if isOwner(statOwner())
        && request.resource.data.uid == statOwner()
        && request.resource.data.watchMs >= 0
        && request.resource.data.watchMs <= 86400000
        && request.resource.data.sessions >= 0
        && request.resource.data.sessions <= 200;

      allow update: if isOwner(statOwner())
        && resource.data.uid == statOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.watchMs >= resource.data.watchMs
        && request.resource.data.watchMs <= 86400000
        && request.resource.data.sessions >= resource.data.sessions
        && request.resource.data.sessions <= 200;

      allow delete: if false;
    }

    // Content totals are the one rollup no client may write: the document id is a content
    // id, so a subscriber could inflate a title that is nothing to do with them. It stays
    // read-only until there is a backend to aggregate it.
    match /contentStats/{contentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ------------------------------------------------------------------ release policy

    // The single document an unsigned-in device is allowed to read. A version floor has to be
    // checkable before any sign-in exists — a revoked session or a wrong device clock must not
    // be able to hide a mandatory update — and everything the document holds (version
    // numbers, an https download URL, digests) is public information about a release the user
    // is being asked to install. Public read is pinned to this one document id, so no other
    // document in the collection becomes reachable and `/config` stays sign-in only.
    //
    // Version ordering cannot be compared here, so "minimum must not exceed latest" is
    // enforced twice outside the rules: by the publishing job that writes this document and
    // by parseReleasePolicy on the device, which refuses such a policy outright.
    match /releasePolicy/{docId} {
      allow read: if docId == 'latest';

      // Shape is checked, not trusted: a document that would make a device download an
      // unidentifiable APK is refused at the write, so the bad state never reaches a phone.
      allow create, update: if isAdmin()
        && docId == 'latest'
        && request.resource.data.minimumSupportedVersion.matches('^[0-9]+[.][0-9]+[.][0-9]+$')
        && request.resource.data.latestVersion.matches('^[0-9]+[.][0-9]+[.][0-9]+$')
        && request.resource.data.apkUrl.matches('^https://.+$')
        && isHash(request.resource.data.apkSha256)
        && isHash(request.resource.data.signingCertSha256)
        && request.resource.data.releaseNotes is string
        && request.resource.data.apkSizeBytes is int
        && request.resource.data.apkSizeBytes > 0
        && request.resource.data.keys().hasAll([
          'minimumSupportedVersion', 'latestVersion', 'apkUrl', 'apkSha256',
          'signingCertSha256', 'releaseNotes', 'apkSizeBytes'
        ]);

      // Withdrawing a release is a legitimate admin action, and the client reads an absent
      // document as 'missing' — which never blocks a device and never claims currency.
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------ config + audit

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && docId == 'app'
        && request.resource.data.offlineGraceMinutes >= 0
        && request.resource.data.offlineGraceMinutes <= 10080
        && request.resource.data.keyDurationDays >= 1
        && request.resource.data.keyDurationDays <= 3650
        && request.resource.data.maxInstallationRotations >= 0
        && request.resource.data.maxInstallationRotations <= 100;
    }

    // Append-only. Every privileged action in the admin app lands here, and nobody gets to
    // edit history.
    match /adminAudit/{id} {
      allow read: if isStaff();
      allow create: if isKeyStaff()
        && request.resource.data.actor == request.auth.token.email
        && request.resource.data.keys().hasAll(['actor', 'action', 'targetType', 'targetId', 'timestamp']);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ default deny

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
